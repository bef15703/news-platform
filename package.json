{
  "name": "news_project",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "docker exec -i news_postgres psql -U dev_user -d news_platform < packages/db/001_initial_schema.sql"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": ">=11.0.1"
    }
  }
}